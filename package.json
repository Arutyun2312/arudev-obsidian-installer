{
    "name": "obsidian-forgejo-installer",
    "version": "0.1.0",
    "description": "Install and update Obsidian plugins from Forgejo/Gitea repositories",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "devDependencies": {
        "esbuild": "^0.24.0",
        "obsidian": "latest",
        "typescript": "^5.6.0"
    }
}
